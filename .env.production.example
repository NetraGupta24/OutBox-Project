# Production settings for docker-compose.prod.yml. Copy to .env.production
# (never commit it) and fill in every value marked "required".
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# Public URL of the app, as users open it (required). Use https in production:
# session cookies are only marked Secure on https.
FRONTEND_URL=https://scheduler.example.com
# Host name for the built-in HTTPS proxy (--profile https): FRONTEND_URL without https://
DOMAIN=scheduler.example.com
# Local port of the web app (127.0.0.1 only), for a proxy of your own instead of Caddy
APP_PORT=3000

# Database (required). Use long random passwords.
MYSQL_DATABASE=reachinbox
MYSQL_USER=reachinbox
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_POOL_SIZE=10

# Secrets (required): openssl rand -hex 32  (or the node one-liner in the README)
ENCRYPTION_KEY=
JWT_SECRET=

# Google sign-in (required). Authorized redirect URI:
#   <FRONTEND_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack alerts (optional). Redirect URL: <FRONTEND_URL>/api/integrations/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Queue dashboard at <FRONTEND_URL>/admin/queues (disabled while empty)
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=

# Ethereal senders, used by: docker compose ... run --rm migrate npm run seed:senders
ETHEREAL_SENDERS=
SEED_SENDER_COUNT=3

# Scheduler tuning
WORKER_CONCURRENCY=5
MIN_SEND_INTERVAL_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
RATE_LIMIT_WINDOW_MS=3600000
MAX_RECIPIENTS_PER_CAMPAIGN=10000

# Elasticsearch heap (the host needs about twice this in free memory)
ES_HEAP=1g
# Elasticsearch refuses writes on a >90% full disk; false turns that check off
ES_DISK_THRESHOLD=true
