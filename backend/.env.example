# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Infrastructure (matches docker-compose.yml defaults)
DATABASE_URL=mysql://reachinbox:reachinbox@localhost:3306/reachinbox
DB_POOL_SIZE=10
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Secrets at rest: generate with `openssl rand -hex 32`
ENCRYPTION_KEY=

# Ethereal senders: leave empty to auto-create accounts with `npm run seed:senders`,
# or paste accounts from https://ethereal.email as user:pass,user:pass
ETHEREAL_SENDERS=
SEED_SENDER_COUNT=3

# Temporary dev login until Google OAuth (phase 6); send header x-dev-user-email
AUTH_DEV_BYPASS=true

# Queue dashboard at /admin/queues (disabled while the password is empty, min 8 characters)
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=

# Scheduler tuning
WORKER_CONCURRENCY=5
MIN_SEND_INTERVAL_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Rate-limit window length. Keep 3600000 (1 hour); use e.g. 60000 to demo limits quickly
RATE_LIMIT_WINDOW_MS=3600000
MAX_RECIPIENTS_PER_CAMPAIGN=10000
# true: build emails but don't connect to SMTP (load tests, offline work)
SMTP_DRY_RUN=false

# Added in later phases:
# GOOGLE_CLIENT_ID=, GOOGLE_CLIENT_SECRET=, GOOGLE_CALLBACK_URL=
# SLACK_CLIENT_ID=, SLACK_CLIENT_SECRET=, SLACK_REDIRECT_URI=
# JWT_SECRET=, ADMIN_EMAILS=
