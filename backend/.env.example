# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Infrastructure (matches docker-compose.yml defaults)
DATABASE_URL=mysql://reachinbox:reachinbox@localhost:3306/reachinbox
DB_POOL_SIZE=10
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Secrets at rest: generate with `openssl rand -hex 32`
ENCRYPTION_KEY=

# Ethereal senders: leave empty to auto-create accounts with `npm run seed:senders`,
# or paste accounts from https://ethereal.email as user:pass,user:pass
ETHEREAL_SENDERS=
SEED_SENDER_COUNT=3

# Sign-in. JWT_SECRET: openssl rand -hex 32
JWT_SECRET=
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, defaults to FRONTEND_URL + /api/auth/google/callback
GOOGLE_CALLBACK_URL=

# Queue dashboard at /admin/queues (disabled while the password is empty, min 8 characters)
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=

# Scheduler tuning
WORKER_CONCURRENCY=5
MIN_SEND_INTERVAL_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Rate-limit window length. Keep 3600000 (1 hour); use e.g. 60000 to demo limits quickly
RATE_LIMIT_WINDOW_MS=3600000
MAX_RECIPIENTS_PER_CAMPAIGN=10000
# true: build emails but don't connect to SMTP (load tests, offline work)
SMTP_DRY_RUN=false

# Slack app for rate-limit alerts (see README "Slack setup")
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional, defaults to FRONTEND_URL + /api/integrations/slack/callback
SLACK_REDIRECT_URI=
